rules_version = '2';
// Circle · family review. Deny by default. Only the owner and invited members get anything.
service cloud.firestore {
  match /databases/{db}/documents {

    function email() { return request.auth.token.email.lower(); }
    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    // Owner is fixed here, not in the database, so no data change can make someone else admin.
    function isOwner() { return signedIn() && email() == 'work.harshsheth@gmail.com'; }
    function isMember() {
      return signedIn() && exists(/databases/$(db)/documents/members/$(email()))
        && get(/databases/$(db)/documents/members/$(email())).data.active == true;
    }
    function cand(id) { return get(/databases/$(db)/documents/candidates/$(id)).data; }
    // A reviewer sees a profile only while it is in its `viewers` list (shared, not hidden, not archived).
    function canSee(id) { return isOwner() || (isMember() && email() in cand(id).viewers); }
    function hasRated(id) { return exists(/databases/$(db)/documents/candidates/$(id)/reviews/$(email())); }

    match /members/{m} {
      allow read: if isOwner() || (signedIn() && m == email());
      allow write: if isOwner();
    }

    // Owner-only settings (the intake link).
    match /admin/{doc} {
      allow read, write: if isOwner();
    }

    match /reference/{doc} {
      allow read: if isOwner() || isMember();
      allow write: if isOwner();
    }

    match /candidates/{id} {
      allow read: if isOwner() || (isMember() && email() in resource.data.viewers);
      allow write: if isOwner();
      // Family can move the stage along their own part of the path and record Harshaben's word. Nothing else.
      allow update: if isMember() && email() in resource.data.viewers
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyStage', 'harshaben', 'sentOn'])
        && request.resource.data.familyStage in ['New', 'Mothers in touch', 'Biodatas exchanged', 'Janmakshar received', 'Waiting for Harshaben', 'Harshaben matched']
        && request.resource.data.get('sentOn', '') is string && request.resource.data.get('sentOn', '').size() <= 10
        && request.resource.data.harshaben in ['', 'Pending', 'Match', 'No match'];

      // Admin-only notes (contact numbers, source, private remarks). Reviewers never read this.
      match /private/{doc} {
        allow read, write: if isOwner();
      }

      // One rating per person. Blind until you rate: you see others' stars only after giving yours.
      match /reviews/{who} {
        allow read: if isOwner() || (canSee(id) && (who == email() || hasRated(id)));
        allow create, update: if canSee(id) && who == email()
          && request.resource.data.keys().hasOnly(['stars', 'name', 'updatedAt'])
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && request.resource.data.name is string && request.resource.data.name.size() <= 60;
        allow delete: if isOwner() || (canSee(id) && who == email());
      }

      // Family's part: spoke to her mother, biodatas exchanged, kundli, feedback on her family.
      match /progress/{doc} {
        allow read: if canSee(id);
        allow write: if canSee(id) && doc == 'family'
          && request.resource.data.keys().hasOnly(['motherContacted', 'contactedOn', 'biodataExchanged', 'birthName', 'birthDate', 'birthTime', 'birthPlace',
               'sentToHarshaben', 'sentOn', 'kundli', 'harshabenNotes', 'familyFeedback', 'updatedBy', 'updatedAt'])
          && request.resource.data.motherContacted is bool && request.resource.data.biodataExchanged is bool
          && request.resource.data.kundli in ['', 'Pending', 'Match', 'No match']
          && request.resource.data.familyFeedback is string && request.resource.data.familyFeedback.size() <= 2000
          && request.resource.data.contactedOn is string && request.resource.data.contactedOn.size() <= 10
          && request.resource.data.get('sentOn', '') is string && request.resource.data.get('sentOn', '').size() <= 10
          && request.resource.data.get('birthName', '').size() <= 60 && request.resource.data.get('birthPlace', '').size() <= 60
          && request.resource.data.get('birthDate', '').size() <= 10 && request.resource.data.get('birthTime', '').size() <= 5
          && request.resource.data.get('harshabenNotes', '').size() <= 2000
          && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 60;
      }

      match /comments/{c} {
        allow read: if canSee(id);
        allow create: if canSee(id)
          && request.resource.data.keys().hasOnly(['email', 'name', 'text', 'createdAt'])
          && request.resource.data.email == email()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.name is string && request.resource.data.name.size() <= 60;
        allow update: if canSee(id) && resource.data.email == email()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
        allow delete: if isOwner() || (canSee(id) && resource.data.email == email());
      }
    }
  }
}
